# ── Required for the app to boot ──────────────────────────────────────────
NODE_ENV=development
PORT=3000

# MongoDB — local or free Atlas cluster
DEV_DB_URL=mongodb://localhost:27017/slack-multi-tenant
PROD_DB_URL=

# JWT
JWT_SECRET=any-random-string-for-local-testing
JWT_EXPIRY=1d

# ── Required only if you run BullMQ-backed jobs (invite emails, etc.) ──
# Defaults to localhost:6379 if unset — just run `redis-server` locally.
REDIS_HOST=localhost
REDIS_PORT=6379

APP_LINK=http://localhost:3000

# ── OPTIONAL — leave blank for local/resume testing, no cost, no card ──
# Payments: leave both blank and payment routes safely return 501.
# To test real Razorpay later, sign up at https://dashboard.razorpay.com/
# and use TEST MODE keys (rzp_test_...) — free, no card required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CURRENCY=INR

# File uploads: leave blank and image upload safely returns 501.
# Text messaging works fully without this.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Email: leave blank and emails are logged to console instead of sent.
# Invite tokens are also returned directly in the API response, so you
# do not need real email delivery to test the invite/accept flow.
MAIL_ID=
MAIL_PASSWORD=
