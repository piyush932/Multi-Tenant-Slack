# Server
NODE_ENV=development
PORT=5000

# MongoDB (local or Atlas free tier)
DEV_DB_URL=mongodb://localhost:27017/slack-multi-tenant
# or: mongodb+srv://<user>:<pass>@cluster.mongodb.net/slack-multi-tenant?retryWrites=true

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-prod
JWT_EXPIRES_IN=7d

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Razorpay (test mode keys — free, no live charges)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# AWS S3 (optional — can stub for demo)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Email (Nodemailer — use Mailtrap or Gmail app password)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@yourapp.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
